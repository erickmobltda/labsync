# ============================================================
# LabSync — environment variables
# Copy this file to .env and fill in the values you need.
# ============================================================

# ── Required for BOTH local and Supabase setups ──────────────
# Your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Local / Docker Compose setup ─────────────────────────────
# JWT signing secret — CHANGE this to a long random string in production!
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-use-a-long-random-string

# Port the frontend will listen on (default: 3000)
# PORT=3000

# ── Supabase setup ────────────────────────────────────────────
# Leave blank for local/Docker mode. Fill in for Supabase mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The Anthropic API key is NOT a frontend variable — it must never be exposed
# in the browser. Set it as a Supabase secret instead:
#   supabase secrets set ANTHROPIC_API_KEY=your-key
# The setup script (scripts/setup-supabase.sh) does this automatically.

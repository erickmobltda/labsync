# Required: your Anthropic API key for biomarker extraction
ANTHROPIC_API_KEY=your-anthropic-api-key

# JWT secret for signing auth tokens — change this in production!
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Optional: custom paths (defaults shown)
# DB_PATH=./data/labsync.db
# UPLOADS_DIR=./data/uploads

# Optional: port (default 3001)
# PORT=3001

# Optional: allowed frontend origins (comma-separated)
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173
